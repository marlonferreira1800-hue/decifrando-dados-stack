# =============================================================================
# Decifrando Dados — variáveis de ambiente
# Copie para .env (o gerador já faz isso) e preencha. NUNCA commite o .env.
# =============================================================================

# --- Geral -------------------------------------------------------------------
PROJECT_NAME=Decifrando Dados
ENVIRONMENT=development
# Origens liberadas no CORS (lista JSON). Adicione a URL do frontend em produção.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- LLMs (formato Pydantic AI "provedor:modelo") ---------------------------
# Exemplos: openai:gpt-4o-mini | openai:gpt-4o | anthropic:claude-3-5-haiku-latest
LLM_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Supabase (Project Settings > API) --------------------------------------
# Use a service_role key SOMENTE no backend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Redis / Celery ----------------------------------------------------------
# Local: redis://localhost:6379/0 (no Docker Compose é sobrescrito para redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# --- Segurança ---------------------------------------------------------------
# Se preenchida, os webhooks exigem o header X-API-Key com este valor.
API_KEY=

# --- Frontend (Vite lê variáveis com prefixo VITE_) --------------------------
# Vazio em dev (usa o proxy do Vite). Em produção: URL pública do backend.
VITE_API_URL=
# Opcional: Supabase no navegador (Auth/Realtime) — use a ANON key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
